{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalDependencies": [".env"],
  // Turbo hides undeclared env vars from tasks (strict mode); these are read by the apps at runtime.
  "globalPassThroughEnv": [
    "NODE_ENV",
    "API_PORT",
    "WEB_ORIGIN",
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "REDIS_URL",
    "JWT_*",
    "REFRESH_TOKEN_TTL_DAYS",
    "SMTP_*",
    "MAIL_FROM",
    "ROOT_ADMIN_*",
    "ANTHROPIC_API_KEY",
    "AI_MODEL"
  ],
  "globalEnv": ["NEXT_PUBLIC_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    // Needs Postgres + Redis (docker compose); never cached because it depends on database state.
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
