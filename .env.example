# ─── Infrastructure (docker compose) ───────────────────────────────
POSTGRES_USER=offerleap
POSTGRES_PASSWORD=offerleap
POSTGRES_DB=offerleap
POSTGRES_PORT=5432
REDIS_PORT=6379
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── API (apps/api) ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://offerleap:offerleap@localhost:5432/offerleap
REDIS_URL=redis://localhost:6379
# Separate database for API e2e tests (created by infra/postgres/init-test-db.sql).
DATABASE_URL_TEST=postgresql://offerleap:offerleap@localhost:5432/offerleap_test

# Auth — generate a secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Email (Mailpit locally: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=OfferLeap <no-reply@offerleap.local>

# Root admin is provisioned by the seed script. Its password cannot be changed or reset
# from the app — rotate it by updating this value and re-running the seed.
ROOT_ADMIN_EMAIL=root@offerleap.local
ROOT_ADMIN_PASSWORD=change-me-to-a-strong-password

# Uploaded files (CVs) — local disk, git-ignored.
STORAGE_DIR=storage

# AI provider: `mock` (canned answers, no key needed) or `gemini`.
# Free Gemini API key: https://aistudio.google.com/apikey — never commit it.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded (503), rate-limited (429) or times out. flash-lite first: it
# supports MINIMAL thinking and answers in seconds; 3.8-flash needs LOW thinking and can take over a minute.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# Successful AI calls per user per rolling 24 hours (admins can override per user; admins have no limit).
AI_DAILY_QUOTA=50

# ─── Web (apps/web) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Production (docker-compose.prod.yml) ──────────────────────────
# Public URLs of the web app and the API (put both behind HTTPS in production).
# PUBLIC_WEB_URL=https://offerleap.example.com
# PUBLIC_API_URL=https://api.offerleap.example.com
