// Database schema. Run `pnpm --filter @offerleap/api prisma migrate dev --name <change>` after editing.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS is compiled to CommonJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AdminLevel {
  ROOT
  GENERAL
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Locale {
  vi
  en
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  passwordHash          String
  fullName              String
  role                  Role           @default(USER)
  /// Only set when role = ADMIN.
  adminLevel            AdminLevel?
  status                UserStatus     @default(ACTIVE)
  locale                Locale         @default(vi)
  emailVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  passwordChangedAt     DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  refreshTokens         RefreshToken[]
  tokens                UserToken[]
  profile               Profile?
  resumes               Resume[]
  analyses              JobAnalysis[]
  applications          JobApplication[]

  @@map("users")
}

/// One row per issued refresh token. Tokens of one login share a `familyId`; rotating marks the old row
/// revoked and links it to its replacement, so a reused (stolen) token can revoke the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  familyId     String
  /// SHA-256 of the opaque token; the token itself is only ever in the client's cookie.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Single-use tokens sent by email (verification, password reset). Stored hashed.
model UserToken {
  id        String        @id @default(cuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

enum ProvinceType {
  CITY
  PROVINCE
}

enum CareerLevel {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
  MANAGER
}

enum WorkType {
  ONSITE
  REMOTE
  HYBRID
}

/// Industry taxonomy. Stored by stable `code`; labels in both languages.
model Industry {
  code      String    @id
  nameVi    String
  nameEn    String
  sortOrder Int       @default(0)
  profiles  Profile[]

  @@map("industries")
}

/// Vietnamese provinces and centrally-run cities (34 units since the 2025 reorganisation).
model Province {
  code      String       @id
  nameVi    String
  nameEn    String
  type      ProvinceType
  sortOrder Int          @default(0)
  profiles  Profile[]

  @@map("provinces")
}

/// Candidate profile filled during onboarding. Every field is nullable so onboarding can be saved as a draft;
/// `User.onboardingCompletedAt` marks when the full set passed validation.
model Profile {
  userId            String       @id
  phone             String?
  provinceCode      String?
  industryCode      String?
  jobTitle          String?
  level             CareerLevel?
  yearsOfExperience Int?
  skills            String[]     @default([])
  expectedSalaryMin Int?
  expectedSalaryMax Int?
  workTypes         WorkType[]   @default([])
  /// Last wizard step the user reached (1-based), so they resume where they left off.
  onboardingStep    Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  province          Province?    @relation(fields: [provinceCode], references: [code])
  industry          Industry?    @relation(fields: [industryCode], references: [code])

  @@index([provinceCode])
  @@index([industryCode])
  @@map("profiles")
}

enum ResumeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// An uploaded CV. The file stays on disk (`storageKey`); a BullMQ job asks the AI to read it and stores the
/// suggested profile values in `suggestions`.
model Resume {
  id           String       @id @default(cuid())
  userId       String
  fileName     String
  mimeType     String
  sizeBytes    Int
  /// Path inside STORAGE_DIR.
  storageKey   String       @unique
  status       ResumeStatus @default(PENDING)
  /// `ResumeSuggestions` from @offerleap/shared, validated before saving.
  suggestions  Json?
  /// ErrorCode when parsing failed.
  errorCode    String?
  aiModel      String?
  inputTokens  Int?
  outputTokens Int?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses     JobAnalysis[]

  @@index([userId, createdAt])
  @@map("resumes")
}

/// A CV compared with a job description by the AI. Runs in the background like CV parsing (same statuses).
model JobAnalysis {
  id             String       @id @default(cuid())
  userId         String
  resumeId       String
  jobDescription String
  /// Language the AI answers in.
  locale         Locale
  status         ResumeStatus @default(PENDING)
  /// Read from the job description by the AI.
  jobTitle       String?
  company        String?
  /// 0–100, copied out of `result` so lists can sort and show it without parsing JSON.
  score          Int?
  /// `AnalysisResult` from @offerleap/shared, validated before saving.
  result         Json?
  errorCode      String?
  aiModel        String?
  inputTokens    Int?
  outputTokens   Int?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applications   JobApplication[]

  @@index([userId, createdAt])
  @@index([resumeId])
  @@map("job_analyses")
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

/// A job the user is tracking on the kanban board, with its cover letter.
model JobApplication {
  id             String            @id @default(cuid())
  userId         String
  company        String
  jobTitle       String
  jobUrl         String?
  jobDescription String?
  status         ApplicationStatus @default(SAVED)
  /// Order inside the column. Fractional: dropping between two cards takes the midpoint.
  position       Float
  notes          String?
  coverLetter    String?
  /// Analysis the application was created from (kept when the analysis is deleted, just unlinked).
  analysisId     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis       JobAnalysis?      @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([userId, status, position])
  @@map("job_applications")
}
