// Database schema. Run `pnpm --filter @offerleap/api prisma migrate dev --name <change>` after editing.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS is compiled to CommonJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AdminLevel {
  ROOT
  GENERAL
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Locale {
  vi
  en
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  /// Null for accounts created with a sign-in provider (Google) that never set a password.
  passwordHash          String?
  fullName              String
  role                  Role                @default(USER)
  /// Only set when role = ADMIN.
  adminLevel            AdminLevel?
  status                UserStatus          @default(ACTIVE)
  locale                Locale              @default(vi)
  emailVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  passwordChangedAt     DateTime?
  lastLoginAt           DateTime?
  /// Per-user override of AI_DAILY_QUOTA (successful AI calls per rolling 24 h); null = default.
  aiDailyQuota          Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  refreshTokens         RefreshToken[]
  tokens                UserToken[]
  profile               Profile?
  resumes               Resume[]
  analyses              JobAnalysis[]
  applications          JobApplication[]
  interviews            InterviewSession[]
  sentInvitations       AdminInvitation[]
  aiUsage               AiUsageLog[]
  documents             KnowledgeDocument[]
  identities            UserIdentity[]

  @@map("users")
}

/// One row per issued refresh token. Tokens of one login share a `familyId`; rotating marks the old row
/// revoked and links it to its replacement, so a reused (stolen) token can revoke the whole family.
enum IdentityProvider {
  GOOGLE
}

/// A sign-in provider account linked to a user. Matched by the provider's stable id (`sub`), never by email: the
/// email at the provider can change. One provider account links to one user, and a user links each provider once.
model UserIdentity {
  id             String           @id @default(cuid())
  userId         String
  provider       IdentityProvider
  providerUserId String
  /// Email at the provider when linked (shown in settings; not used for matching).
  email          String
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("user_identities")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  familyId     String
  /// SHA-256 of the opaque token; the token itself is only ever in the client's cookie.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Single-use tokens sent by email (verification, password reset). Stored hashed.
model UserToken {
  id        String        @id @default(cuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

enum ProvinceType {
  CITY
  PROVINCE
}

enum CareerLevel {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
  MANAGER
}

enum WorkType {
  ONSITE
  REMOTE
  HYBRID
}

/// Industry taxonomy. Stored by stable `code`; labels in both languages.
model Industry {
  code      String    @id
  nameVi    String
  nameEn    String
  sortOrder Int       @default(0)
  profiles  Profile[]

  @@map("industries")
}

/// Vietnamese provinces and centrally-run cities (34 units since the 2025 reorganisation).
model Province {
  code      String       @id
  nameVi    String
  nameEn    String
  type      ProvinceType
  sortOrder Int          @default(0)
  profiles  Profile[]

  @@map("provinces")
}

/// Candidate profile filled during onboarding. Every field is nullable so onboarding can be saved as a draft;
/// `User.onboardingCompletedAt` marks when the full set passed validation.
model Profile {
  userId            String       @id
  phone             String?
  provinceCode      String?
  industryCode      String?
  jobTitle          String?
  level             CareerLevel?
  yearsOfExperience Int?
  skills            String[]     @default([])
  expectedSalaryMin Int?
  expectedSalaryMax Int?
  workTypes         WorkType[]   @default([])
  /// Last wizard step the user reached (1-based), so they resume where they left off.
  onboardingStep    Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  province          Province?    @relation(fields: [provinceCode], references: [code])
  industry          Industry?    @relation(fields: [industryCode], references: [code])

  @@index([provinceCode])
  @@index([industryCode])
  @@map("profiles")
}

enum ResumeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// An uploaded CV. The file stays on disk (`storageKey`); a BullMQ job asks the AI to read it and stores the
/// suggested profile values in `suggestions`.
model Resume {
  id           String        @id @default(cuid())
  userId       String
  fileName     String
  mimeType     String
  sizeBytes    Int
  /// Path inside STORAGE_DIR.
  storageKey   String        @unique
  status       ResumeStatus  @default(PENDING)
  /// `ResumeSuggestions` from @offerleap/shared, validated before saving.
  suggestions  Json?
  /// ErrorCode when parsing failed.
  errorCode    String?
  aiModel      String?
  inputTokens  Int?
  outputTokens Int?
  processedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses     JobAnalysis[]

  @@index([userId, createdAt])
  @@map("resumes")
}

/// A CV compared with a job description by the AI. Runs in the background like CV parsing (same statuses).
model JobAnalysis {
  id             String           @id @default(cuid())
  userId         String
  resumeId       String
  jobDescription String
  /// Language the AI answers in.
  locale         Locale
  status         ResumeStatus     @default(PENDING)
  /// Read from the job description by the AI.
  jobTitle       String?
  company        String?
  /// 0–100, copied out of `result` so lists can sort and show it without parsing JSON.
  score          Int?
  /// `AnalysisResult` from @offerleap/shared, validated before saving.
  result         Json?
  errorCode      String?
  aiModel        String?
  inputTokens    Int?
  outputTokens   Int?
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applications   JobApplication[]

  @@index([userId, createdAt])
  @@index([resumeId])
  @@map("job_analyses")
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

/// A job the user is tracking on the kanban board, with its cover letter.
model JobApplication {
  id             String             @id @default(cuid())
  userId         String
  company        String
  jobTitle       String
  jobUrl         String?
  jobDescription String?
  status         ApplicationStatus  @default(SAVED)
  /// Order inside the column. Fractional: dropping between two cards takes the midpoint.
  position       Float
  notes          String?
  coverLetter    String?
  /// Analysis the application was created from (kept when the analysis is deleted, just unlinked).
  analysisId     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis       JobAnalysis?       @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  interviews     InterviewSession[]

  @@index([userId, status, position])
  @@map("job_applications")
}

enum InterviewType {
  BEHAVIORAL
  TECHNICAL
  MIXED
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

/// A mock interview: AI-written questions, the user's answers with feedback, and a final summary.
model InterviewSession {
  id               String              @id @default(cuid())
  userId           String
  /// Application practised for (kept when the application is deleted, just unlinked).
  applicationId    String?
  jobTitle         String
  jobDescription   String?
  type             InterviewType
  locale           Locale
  status           InterviewStatus     @default(IN_PROGRESS)
  /// 0–100, set when the interview is completed (copied out of `result` for lists).
  overallScore     Int?
  /// `InterviewSummary` from @offerleap/shared.
  result           Json?
  aiModel          String?
  /// Tokens of every AI call in this session (questions, feedback, summary).
  inputTokens      Int                 @default(0)
  outputTokens     Int                 @default(0)
  completedAt      DateTime?
  /// Set while the AI writes the summary (same purpose as `InterviewQuestion.scoringStartedAt`).
  summaryStartedAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      JobApplication?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  questions        InterviewQuestion[]

  @@index([userId, createdAt])
  @@map("interview_sessions")
}

model InterviewQuestion {
  id               String           @id @default(cuid())
  sessionId        String
  /// 0-based order in the interview.
  index            Int
  question         String
  /// What the question assesses.
  focus            String
  answer           String?
  skipped          Boolean          @default(false)
  /// 0–10.
  score            Int?
  feedback         String?
  betterAnswer     String?
  answeredAt       DateTime?
  /// Set while the AI scores an answer, so a second request for the same question doesn't call the AI again.
  /// Expires (see InterviewsService) in case the process dies mid-call.
  scoringStartedAt DateTime?
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, index])
  @@map("interview_questions")
}

/// An invitation for a general admin, sent by root. Only a hash of the token is stored; accepting it creates an
/// already-verified ADMIN/GENERAL account.
model AdminInvitation {
  id          String    @id @default(cuid())
  email       String
  /// SHA-256 of the token in the email link.
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("admin_invitations")
}

/// One AI call (success or failure), written by the tracking provider. Feeds the usage dashboard and quotas.
model AiUsageLog {
  id           String   @id @default(cuid())
  /// Kept when the user is deleted (set to null) so totals stay correct.
  userId       String?
  /// Prompt id + version, e.g. `job-match.v1`.
  task         String
  /// Model that answered; null when no model could.
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int
  success      Boolean
  /// Error class name for failures (AiUnavailableError, AiInvalidOutputError…).
  errorType    String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

enum KnowledgeSource {
  UPLOAD
  TEXT
}

/// A personal document (project notes, certificates…) split into chunks with embeddings for retrieval (RAG).
/// Processed in the background like CVs, so it shares their statuses.
model KnowledgeDocument {
  id             String           @id @default(cuid())
  userId         String
  title          String
  source         KnowledgeSource
  fileName       String?
  mimeType       String?
  /// Uploaded file inside STORAGE_DIR (pasted text has none).
  storageKey     String?          @unique
  status         ResumeStatus     @default(PENDING)
  errorCode      String?
  chunkCount     Int              @default(0)
  charCount      Int              @default(0)
  /// Model the chunks were embedded with: a query must use the same one to be comparable.
  embeddingModel String?
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         KnowledgeChunk[]

  @@index([userId, createdAt])
  @@map("knowledge_documents")
}

/// One passage of a document and its embedding (pgvector). `userId` is copied here so a similarity search can
/// filter by owner without a join. No ANN (HNSW) index on purpose: searches are always per user (a few hundred
/// chunks at most), where an exact scan is fast and never misses — an ANN index filters by user only afterwards.
model KnowledgeChunk {
  id         String                      @id @default(cuid())
  documentId String
  userId     String
  index      Int
  content    String
  embedding  Unsupported("vector(768)")?
  document   KnowledgeDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

/// Uploaded files when STORAGE_DRIVER=database: for hosts whose disk is wiped on restart (free tiers). The key is
/// the same as the disk path would be (`resumes/<user>/<id>.pdf`), so rows match `Resume.storageKey` etc.
model StoredFile {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now())

  @@map("stored_files")
}
